{
  "title": "Volumetric Generation Recipes",
  "version": "1.0.0",
  "recipe_count": 8,
  "theoretical_space": {
    "context_axes_product": "12 × 10 × 9 × 13 × 9 × 4 × 5 × 5 × 7 × 5 × 8 × 7",
    "laka_dynamic_states": 56,
